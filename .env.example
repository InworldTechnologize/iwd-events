# Owner connection: migrations and seeding only (table owner).
DATABASE_URL_OWNER=postgres://postgres:postgres@localhost:5432/iwd
# App connection: the non-owner role the app and workers use. RLS applies to it.
DATABASE_URL=postgres://iwd_app:iwd_app@localhost:5432/iwd
REDIS_URL=redis://localhost:6379
# Root domain tenants live under (<slug>.<ROOT_DOMAIN>). Dev: localhost.
ROOT_DOMAIN=localhost
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-32-chars-minimum-xxxxxxxx
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=iwd
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
